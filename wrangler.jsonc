{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mailschema",
  "main": "./worker.js",
  "compatibility_date": "2026-09-23",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "mailschema.org",
      "custom_domain": true,
    },
    {
      "pattern": "www.mailschema.org",
      "custom_domain": true,
    },
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": true,
  },
  "observability": {
    "enabled": true,
  },
}
