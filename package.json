{
  "name": "mailschema",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "npm run registry:validate && npm run profile:validate && npm run map:test && npm run readiness:audit && npm run conformance:check && astro check",
    "registry:validate": "node scripts/registry.ts validate",
    "registry:ingest": "node scripts/registry.ts ingest",
    "verify": "npm run check && npm run build && npm test",
    "build": "astro build",
    "deploy": "npm run verify && wrangler deploy",
    "deploy:dry-run": "npm run build && wrangler deploy --dry-run",
    "preview": "astro preview --host 127.0.0.1",
    "social:generate": "node scripts/generate-social-card.mjs",
    "test": "playwright test",
    "test:visual": "node scripts/compare-reader.mjs",
    "packages:prepare": "node scripts/prepare-packages.mjs",
    "packages:promote": "node scripts/promote-package.mjs",
    "packages:test": "node --test tests/packages-check.mjs",
    "profile:validate": "node scripts/map-profile.ts",
    "map:test": "node --test tests/map-profile.test.mjs",
    "readiness:audit": "node scripts/audit-map-readiness.mjs",
    "conformance:check": "node scripts/conformance.ts"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "astro": "7.3.5",
    "sourcey": "3.6.8"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/sitemap": "^3.7.4",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/jsonld": "1.5.15",
    "@types/mailparser": "3.4.6",
    "@types/node": "24.13.6",
    "canonicalize": "5.1.0",
    "jsonld": "9.0.0",
    "mailparser": "3.9.28",
    "pixelmatch": "7.2.0",
    "pngjs": "7.0.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.0.1",
    "typescript": "5.9.3",
    "wrangler": "^4.137.0"
  }
}
