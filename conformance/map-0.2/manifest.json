      "id": "description-rules",
      "title": "service and client refuse descriptions that repeat an operation, expire before they begin, or name a party under possession",
      "expected": "each refused"
    },
    {
      "id": "client-prepare",
      "title": "a client prepares only offered operations with input its contract accepts",
      "expected": "invalid input and unoffered operations refused before sending"
    },
    {
      "id": "http-binding",
      "title": "the HTTP binding fixes methods, media type and where credentials travel",
      "expected": "405 with Allow, 415 for every refused shared media type vector, a MAP 401 and the expanded result URL in Location; possession requests carry no credentials and refuse redirects"
    },
    {
      "id": "utf8-strict",
      "title": "a designated part that is not valid UTF-8, or starts with a byte order mark, is refused",
      "expected": "refused before use, never repaired"
    },
    {
      "id": "lexical-forms",
      "title": "every lexical form is the core pattern, whichever validator reads it",
      "expected": "every shared lexical vector decided by the core definition; unparseable dates refused"
    },
    {
      "id": "message-date",
      "title": "a message Date is an RFC 5322 section 3.3 date-time, read strictly",
      "expected": "numeric zones and years from 1900 only; names in any case"
    },
    {
      "id": "retention-latest-state",
      "title": "retention runs from the latest recorded state",
      "expected": "a result decided late stays retained for the full interval after its decision"
    },
    {
      "id": "consequence-policy",
      "title": "possession operations beyond refusal, protection and record need a relationship or the principal",
      "expected": "policy follows consequences"
    },
    {
      "id": "capability-scope",
      "title": "a possession interaction issues a sound capability and answers only it",
      "expected": "weak issuance refused; 404 plain; 410 plain at expiry plus retention, however often refusals are recorded after expiry"
    },
    {
      "id": "possession-trust",
      "title": "genuine possession messages are trusted for their organization, recipient and list",
      "expected": "organizational domain returned, with addresses compared as A-labels"
    },
    {
      "id": "possession-refusals",
      "title": "weak, forged, restructured or misdirected possession messages are refused for the rule they break",
      "expected": "every negative message refused with its reason"
    },
    {
      "id": "lookalike-domain",
      "title": "an authentic lookalike domain cannot satisfy the confirmation rule",
      "expected": "trusted for examp1e.com, never confirmed"
    },
    {
      "id": "organizational-domain",
      "title": "the organizational domain follows the RFC 9989 tree walk and fails closed",
      "expected": "published records decide; DNS failures and top-level domains refuse"
    },
    {
      "id": "untrusted-endpoints",
      "title": "every credential-bearing endpoint, resource and the human route are configured",
      "expected": "client refusal before credential use"
    },
    {
      "id": "metadata-configuration",
      "title": "protected resource metadata configures a service without extending trust",
      "expected": "configured resource anchors every endpoint"
    },
    {
      "id": "jsonld-identity",
      "title": "JSON-LD identity is stable without remote resolution for every type",
      "expected": "base-independent IRIs; details a JSON literal"
    },
    {
      "id": "structured-email-designation",
      "title": "a real MIME parser finds the one designated structured part",
      "expected": "one part labelled with the profile in a partial representation"
    },
    {
      "id": "structured-email-selection",
      "title": "a client processes the one part labelled with its profile, wherever the partial representation sits",
      "expected": "other structured parts ignored; two labelled parts, none, or one outside a partial representation refused"
    },
    {
      "id": "contract-identity",
      "title": "wire compatibility is bound to the canonical contract, not the Registry record",
      "expected": "editorial changes do not change contractDigest"
    },
    {
      "id": "problem-correlation",
      "title": "problem type, status and code agree",
      "expected": "contradictory problems and misplaced errors rejected"
    },
    {
      "id": "result-shape",
      "title": "approval links and reasons appear exactly with their states",
      "expected": "schema enforces the core members"
    },
    {
      "id": "details-integers",
      "title": "details carry integers only, with ASCII keys",
      "expected": "fractions and non-ASCII keys rejected"
    },
    {
