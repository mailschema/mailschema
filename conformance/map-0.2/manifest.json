  ],
  "cases": [
    {
      "id": "approve-completed",
      "title": "approval records one completed effect",
      "expected": "200 completed"
    },
    {
      "id": "feedback-accepted",
      "title": "feedback is recorded with a service-issued identifier",
      "expected": "200 accepted"
    },
    {
      "id": "exact-retry",
      "title": "an exact retry returns the saved result without another effect",
      "expected": "saved response and one effect"
    },
    {
      "id": "stable-redelivery",
      "title": "redelivery reuses the request for an instruction, and a new instruction is a new request",
      "expected": "same requestId and one effect on redelivery; accept, decline and accept again leave accepted"
    },
    {
      "id": "lost-response-recovery",
      "title": "an authorized caller retrieves a saved result",
      "expected": "saved response from result resource"
    },
    {
      "id": "retry-current-authorization",
      "title": "a retry rechecks current access",
      "expected": "an uncorrelated 403 while revoked, the recorded result once restored, and one effect"
    },
    {
      "id": "recovery-current-authorization",
      "title": "result recovery rechecks current access",
      "expected": "403 after revocation"
    },
    {
      "id": "principal-isolation",
      "title": "request identifiers do not cross principals, and each tenant has its own",
      "expected": "403 within the tenant, a separate request in another, and no duplicate effect"
    },
    {
      "id": "actor-attribution",
      "title": "the acting client is recorded apart from the principal and stays on every transition",
      "expected": "first actor on the proposal and the decision"
    },
    {
      "id": "changed-request",
      "title": "changed reuse of a request ID conflicts",
      "expected": "409 idempotency-conflict"
    },
    {
      "id": "unknown-interaction",
      "title": "a request cannot select another interaction",
      "expected": "400 invalid-request, unclaimed"
    },
    {
      "id": "malformed-unclaimed",
      "title": "a malformed request does not claim its request identifier",
      "expected": "400 problem and later 404 result-not-found"
    },
    {
      "id": "invalid-type-input",
      "title": "a type-invalid claimed request is recoverable, points at its input and cannot be replaced",
      "expected": "saved 400 with escaped operation-specific pointers within the problem limits, then 409 idempotency-conflict"
    },
    {
      "id": "permission-refusal",
      "title": "a recognized unauthorized request records one terminal refusal",
      "expected": "stable 403 refused and no effect"
    },
    {
      "id": "authentication-context",
      "title": "credential execution requires server-established principal and tenant",
      "expected": "rejected before processing"
    },
    {
      "id": "stale-revision",
      "title": "staleness is reported from service state with the current target",
      "expected": "409 stale-target"
    },
    {
      "id": "expired-interaction",
      "title": "expiry is exclusive at the stated instant",
      "expected": "410 expired-interaction"
    },
    {
      "id": "unsupported-type",
      "title": "the type URI, version and contract digest must each match exactly",
      "expected": "422 unsupported-type for any difference"
    },
    {
      "id": "unsupported-operation",
      "title": "only an operation offered by the interaction can run",
      "expected": "422 unsupported-operation"
    },
    {
      "id": "approval-gate",
      "title": "additional service approval is a non-terminal result with a core approval link",
      "expected": "202 approval-required"
    },
    {
      "id": "approval-team-decision",
      "title": "an authorized teammate can decide a proposed approval",
      "expected": "200 completed and one effect"
    },
    {
      "id": "approval-unauthorized-decision",
      "title": "an unauthorized human cannot decide or end a proposed approval",
      "expected": "403 and original approval-required result"
    },
    {
      "id": "approval-rule-refusal",
      "title": "service rules can refuse an approval without ending the proposal",
      "expected": "403, unchanged proposal, then declined"
    },
    {
      "id": "approval-declined",
      "title": "an authorized human can decline a proposed approval",
      "expected": "200 failed declined"
    },
    {
      "id": "approval-stale-target",
      "title": "an approval fails if the target changes before the decision",
      "expected": "200 failed stale-target"
    },
    {
      "id": "approval-expired",
      "title": "an undecided approval ends as expired at the deadline without a decision attempt",
      "expected": "recovery shows failed expired"
    },
    {
      "id": "approval-withdrawn",
      "title": "a service ends a pending proposal only for a reason its type declares",
      "expected": "200 failed withdrawn; undeclared reasons refused"
    },
    {
      "id": "retention-expiry",
      "title": "expired retained results never cause another effect",
      "expected": "410 retry, missing recovery, one effect"
    },
    {
      "id": "unknown-result",
      "title": "an unknown result does not invent an interaction identifier",
      "expected": "404 result-not-found"
    },
    {
      "id": "forged-description",
      "title": "a request built from a changed copy of a genuine description is refused, for every type",
      "expected": "unclaimed 400 and no effect for each change"
    },
    {
      "id": "decisions-once",
      "title": "the first decision decides the interaction",
      "expected": "409 already-decided for later decisions"
    },
    {
      "id": "superseded-proposal",
      "title": "a decision ends other pending proposals as superseded",
      "expected": "200 failed superseded"
    },
    {
      "id": "decision-states",
      "title": "a decision decides in either success state, and never ends repeatable work",
      "expected": "409 already-decided after an accepted decision; an approval of repeatable work outlives it"
    },
    {
      "id": "repeatable-operations",
      "title": "repeatable operations stay available and the latest calendar reply stands",
      "expected": "each reply completes"
    },
    {
      "id": "content-review-description",
      "title": "content-review: the description satisfies the core and its contract",
      "expected": "valid, verified and reproducible"
    },
    {
      "id": "content-review-operations",
      "title": "content-review: every operation reaches its declared state",
      "expected": "fixture results reproduced"
    },
    {
      "id": "content-review-authority",
      "title": "content-review: an interaction offers only operations its authority permits",
      "expected": "refused where the contract forbids the mode, accepted where it permits it"
    },
