      "title": "RFC 8785 vectors reproduce and bind the description",
      "expected": "every vector matches"
    },
    {
      "id": "i-json",
      "title": "MAP documents are parsed as I-JSON within the core limits",
      "expected": "every shared I-JSON vector decided at its boundary, and read to its RFC 8785 form"
    },
    {
      "id": "contract-rules",
      "title": "the Registry refuses contracts that break the core rules",
      "expected": "the unchanged contract loads, and each mutation is refused by its own rule"
