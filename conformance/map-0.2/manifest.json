      "id": "field-bindings",
      "title": "form values must match the fields the interaction defined, and are absent where it defines none",
      "expected": "400 invalid-request with pointers; values without fields refused"
    },
    {
      "id": "secret-fields-refused",
      "title": "forms never label a field as a password, code or card detail, and their fields are consistent",
      "expected": "details rejected"
    },
    {
      "id": "slot-rules",
      "title": "offered slots are distinct and in order, a booking names one, and a taken time books nothing",
      "expected": "repeated or reversed slots refused by service and client; invalid-request, then failed unavailable"
    },
    {
      "id": "payment-date",
      "title": "a payment date after the due date is refused",
      "expected": "invalid-request /paymentDate"
    },
    {
      "id": "calendar-sequence",
      "title": "calendar types use the iCalendar SEQUENCE as the revision",
      "expected": "service refuses another revision form"
    },
    {
      "id": "calendar-binding",
      "title": "the target digest binds one iCalendar REQUEST naming the component, SEQUENCE and attendee",
      "expected": "an event and a to-do bound; changed, cancelled, ranged, misaddressed or other-component parts refused"
    },
    {
      "id": "email-confirmation-rule",
      "title": "confirmation needs exactly one prior matching request and no code in the message",
      "expected": "confirm only on an unambiguous recorded match"
    },
    {
      "id": "account-activity-rule",
      "title": "confirming needs one recorded match with an event type; reports come only from the principal",
      "expected": "confirm a recorded sign-in; never report alone"
