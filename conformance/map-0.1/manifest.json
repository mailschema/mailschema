  "cases": [
    {
      "id": "approve-completed",
      "title": "approval records one completed effect",
      "expected": "200 completed"
    },
    {
      "id": "feedback-accepted",
      "title": "feedback is recorded against the described revision",
      "expected": "200 accepted"
    },
    {
      "id": "exact-retry",
      "title": "an exact retry returns the saved result without another effect",
      "expected": "saved response and one effect"
    },
    {
      "id": "stable-redelivery",
      "title": "redelivery preserves the interaction identifier",
      "expected": "same interactionId"
    },
    {
      "id": "lost-response-recovery",
      "title": "an authorized caller retrieves a saved result",
      "expected": "saved response from result resource"
    },
    {
      "id": "retry-current-authorization",
      "title": "a retry rechecks current access",
      "expected": "403 after revocation and one effect"
    },
    {
      "id": "recovery-current-authorization",
      "title": "result recovery rechecks current access",
      "expected": "403 after revocation"
    },
    {
      "id": "principal-isolation",
      "title": "request identifiers do not cross principals",
      "expected": "403 and no duplicate effect"
    },
    {
      "id": "changed-request",
      "title": "changed reuse of a request ID conflicts",
      "expected": "409 idempotency-conflict"
    },
    {
      "id": "unknown-interaction",
      "title": "a request cannot select another interaction",
      "expected": "400 invalid-request"
    },
    {
      "id": "malformed-unclaimed",
      "title": "a malformed request does not claim its request identifier",
      "expected": "400 problem and later 404 result-not-found"
    },
    {
      "id": "invalid-type-input",
      "title": "a type-invalid operation input has no effect",
      "expected": "400 invalid-request"
    },
    {
      "id": "permission-refusal",
      "title": "a recognized unauthorized request records one terminal refusal",
      "expected": "stable 403 refused and no effect"
    },
    {
      "id": "authentication-context",
      "title": "execution requires server-established principal and tenant",
      "expected": "request rejected before processing"
    },
    {
      "id": "stale-revision",
      "title": "a request is compared with current service state",
      "expected": "409 stale-target"
    },
    {
      "id": "expired-interaction",
      "title": "expiry is exclusive at the stated instant",
      "expected": "410 expired-interaction"
    },
    {
      "id": "unsupported-type",
      "title": "the exact type reference is enforced",
      "expected": "422 unsupported-type"
    },
    {
      "id": "unsupported-operation",
      "title": "only an operation offered by the interaction can run",
      "expected": "422 unsupported-operation"
    },
    {
      "id": "approval-gate",
      "title": "additional service approval is a non-terminal result",
      "expected": "202 approval-required"
    },
    {
      "id": "pending-work",
      "title": "outstanding work is recoverable without a recorded effect",
      "expected": "202 pending"
    },
    {
      "id": "pending-completion",
      "title": "a non-terminal result advances once",
      "expected": "latest completed result and one effect"
    },
    {
      "id": "pending-failure",
      "title": "accepted asynchronous work can terminate without an effect",
      "expected": "latest failed result and no effect"
    },
    {
      "id": "retention-expiry",
      "title": "expired retained results never cause another effect",
      "expected": "410 retry, missing recovery, one effect"
    },
    {
      "id": "unknown-result",
      "title": "an unknown result does not invent an interaction identifier",
      "expected": "404 result-not-found correlated only to requestId"
    },
    {
      "id": "untrusted-endpoints",
      "title": "all credential-bearing endpoints and audiences are configured",
      "expected": "client refusal before credential use"
    },
    {
      "id": "jsonld-identity",
      "title": "JSON-LD identity is stable without remote resolution",
      "expected": "base-independent MAP IRIs"
    },
    {
      "id": "structured-email-designation",
      "title": "a real MIME parser finds the designated structured part",
      "expected": "one designated JSON-LD part"
    },
    {
      "id": "contract-identity",
      "title": "wire compatibility is bound to the canonical type contract",
      "expected": "Registry editorial changes do not change contractDigest"
    },
    {
      "id": "problem-correlation",
      "title": "problem type, status and code agree",
      "expected": "contradictory problem rejected"
    }
  ],
