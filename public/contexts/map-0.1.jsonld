{
  "@context": {
    "@version": 1.1,
    "map": "https://mailschema.org/ns/map#",
    "schema": "https://schema.org/",
    "MailAction": "map:MailAction",
    "profile": {
      "@id": "map:profile",
      "@type": "@id"
    },
    "type": {
      "@id": "map:interactionType",
      "@context": {
        "id": {
          "@id": "map:id",
          "@type": "@id"
        }
      }
    },
    "version": "schema:version",
    "contractDigest": "map:contractDigest",
    "describedAt": {
      "@id": "schema:dateCreated",
      "@type": "http://www.w3.org/2001/XMLSchema#dateTime"
    },
    "expiresAt": {
      "@id": "schema:expires",
      "@type": "http://www.w3.org/2001/XMLSchema#dateTime"
    },
    "service": {
      "@id": "schema:provider",
      "@context": {
        "id": {
          "@id": "map:id",
          "@type": "@id"
        }
      }
    },
    "name": "schema:name",
    "execution": "map:execution",
    "url": {
      "@id": "schema:url",
      "@type": "@id"
    },
    "method": "map:httpMethod",
    "requestMediaType": "map:requestMediaType",
    "resultMediaType": "map:resultMediaType",
    "resultUrlTemplate": "map:resultUrlTemplate",
    "resultRetentionSeconds": "map:resultRetentionSeconds",
    "humanUrl": {
      "@id": "map:humanUrl",
      "@type": "@id"
    },
    "authorization": "map:authorization",
    "kind": "map:kind",
    "schemes": "map:authorizationScheme",
    "audience": "map:audience",
    "target": {
      "@id": "schema:object",
      "@context": {
        "id": {
          "@id": "map:id",
          "@type": "@id"
        }
      }
    },
    "revision": "schema:version",
    "title": "schema:name",
    "digest": "map:digest",
    "operations": {
      "@id": "schema:potentialAction",
      "@container": "@set",
      "@context": {
        "id": "map:operationId"
      }
    },
    "description": "schema:description",
    "inputSchema": {
      "@id": "map:inputSchema",
      "@type": "@id"
    }
  }
}
