---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { research, groups, sources } from '../../data/interfaces';
import '../../styles/catalog.css';
---

<Base
  title="Service interface research"
  theme="light"
  description="A sourced assessment of service APIs, agent protocols, messaging, discovery, identity and existing workflows for MAP."
>
  <main id="main" class="container interface-research" data-interface-research>
    <header class="page-hero">
      <span class="eyebrow eyebrow-line">MAP · Design research</span>
      <h1>Work with what exists.</h1>
      <p class="lead">
        APIs, tools, agents and messaging systems can carry a decision. The question is what each
        already provides, and what a MAP binding still needs to establish.
      </p>
      <div class="research-links">
        <a href="/specification/interfaces">
          How this shapes MAP <Icon size={15} />
        </a>
        <a href="/interfaces/report.md" download>
          Download the research <Icon size={15} />
        </a>
      </div>
    </header>
    <section class="research-context" aria-label="Scope and method">
      <strong>
        {research.entries.length} entries · {groups.length} groups · {Object.keys(sources).length}{' '}
        primary sources
      </strong>
      <p>
        Capabilities below are drawn from the linked specifications and project documentation.
        Possible uses and remaining requirements are design assessments. No entry claims a tested
        MAP implementation.
      </p>
    </section>
    <section class="research-controls" data-controls hidden aria-label="Filter the research">
      <label>
        Find an interface
        <input type="search" data-query placeholder="Protocol, feature or requirement" />
      </label>
      <label>
        Area
        <select data-group>
          <option value="">All areas</option>
          {groups.map((group) => (
            <option value={group.id}>{group.name}</option>
          ))}
        </select>
      </label>
      <label>
        Assessment
        <select data-disposition>
          <option value="">All assessments</option>
          {[...new Set(research.entries.map((entry) => entry.disposition))].map((value) => (
            <option value={value}>{value}</option>
          ))}
        </select>
      </label>
      <button type="button" data-reset>
        Reset
      </button>
    </section>
    <p class="research-count" data-count role="status" aria-live="polite">
      {research.entries.length} entries
    </p>
    <div class="research-layout">
      <nav class="research-nav" aria-label="Research areas">
        {groups.map((group) => (
          <a href={`#${group.id}`}>
            {group.name}
            <span>{group.entries.length}</span>
          </a>
        ))}
        <a href="#reuse">
          Reuse comparison
          <Icon size={13} />
        </a>
      </nav>
      <div class="research-results">
        {groups.map((group) => (
          <section class="research-group" id={group.id} data-result-group>
            <h2>{group.name}</h2>
            {group.entries.map((entry) => (
              <details
                class="research-entry"
                id={entry.id}
                data-entry
                data-group={group.id}
                data-disposition={entry.disposition}
              >
                <summary>
                  <span>
                    <strong>{entry.name}</strong>
                    <small>{entry.status}</small>
                  </span>
                  <span class="research-assessment">{entry.disposition}</span>
                  <span class="research-expand" aria-hidden="true">
                    +
                  </span>
                </summary>
                <div class="research-detail">
                  <dl>
                    <div>
                      <dt>Already provides</dt>
                      <dd>{entry.provides}</dd>
                    </div>
                    <div>
                      <dt>Possible MAP use</dt>
                      <dd>{entry.mapping}</dd>
                    </div>
                    <div>
                      <dt>Still needs</dt>
                      <dd>{entry.gap}</dd>
                    </div>
                  </dl>
                  <div class="research-sources">
                    <span>Primary sources</span>
                    {entry.sources.map((id, i) => (
                      <a href={sources[id].url}>
                        {entry.sources.length === 1
                          ? new URL(sources[id].url).hostname.replace(/^www\./, '')
                          : `${i + 1}. ${new URL(sources[id].url).hostname.replace(/^www\./, '')}`}
                        <Icon name="northeast" size={13} />
                      </a>
                    ))}
                  </div>
                </div>
              </details>
            ))}
          </section>
        ))}
        <p class="research-empty" data-empty hidden>
          No matching entries. Change the filters or reset to the full catalogue.
        </p>
        <section class="research-reuse" id="reuse">
          <span class="eyebrow">The architectural consequence</span>
          <h2>
            Reuse the description.
            <br />
            Keep the decision precise.
          </h2>
          <p>
            MAP connects a specific type contract to an operation the service already provides.
            The surrounding APIs, tools and identity systems already exist. This draft does not
            invent one mapping format for every service.
          </p>
          {research.reuseComparison.map((item) => (
            <article>
              <h3>{item.name}</h3>
              <p>{item.existing}</p>
              <p>
                <strong>The MAP gap:</strong> {item.remaining}
              </p>
              <p class="research-recommendation">{item.decision}</p>
              <div class="research-sources">
                {item.sources.map((id) => (
                  <a href={sources[id].url}>
                    {id}
                    <Icon name="northeast" size={13} />
                  </a>
                ))}
              </div>
            </article>
          ))}
        </section>
        <section class="research-questions">
          <h2>Still to establish in implementations</h2>
          <ul>
            {research.openQuestions.map((question) => (
              <li>{question}</li>
            ))}
          </ul>
          <p>
            {research.scope} The <a href="/interfaces/catalog.json">source catalogue</a> records
            retrieval URLs, times and byte hashes for the evidence.
          </p>
        </section>
      </div>
    </div>
  </main>
</Base>
<script>
  import '../../scripts/interface-research';
</script>
<style>
  .research-links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 26px;
    margin-top: 28px;
  }
  .research-links a {
    display: inline-flex;
    gap: 10px;
    align-items: center;
    font-size: 12px;
    font-weight: 650;
    color: var(--blue-ink);
  }
  .research-context {
    display: grid;
    grid-template-columns: 1fr 1.5fr;
    gap: 32px;
    padding: 26px 0;
    border-block: 1px solid var(--line-light);
  }
  .research-context strong {
    font-size: 12px;
  }
  .research-context p {
    margin: 0;
    font-size: 12px;
    color: oklch(43% 0.014 275);
  }
  .research-controls {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr auto;
    gap: 18px;
    align-items: end;
    padding: 28px 0 10px;
  }
  .research-controls label {
    font-size: 11px;
    font-weight: 600;
    min-width: 0;
  }
  .research-controls input,
  .research-controls select {
    display: block;
    margin-top: 9px;
    width: 100%;
    min-width: 0;
    padding: 11px 12px;
    border: 1px solid var(--line-light);
    background: var(--paper);
    color: var(--ink);
    border-radius: 0;
    font-size: 12px;
  }
  .research-controls button {
    border: 0;
    background: transparent;
    color: var(--blue-ink);
    padding: 12px 0;
    font-size: 12px;
  }
  .research-count {
    font-size: 11px;
    color: oklch(43% 0.014 275);
    margin: 12px 0 32px;
  }
  .research-layout {
    display: grid;
    grid-template-columns: 220px minmax(0, 1fr);
    gap: clamp(35px, 5vw, 80px);
    align-items: start;
    padding-bottom: 100px;
  }
  .research-nav {
    position: sticky;
    top: 110px;
    display: grid;
    gap: 18px;
    padding-top: 7px;
  }
  .research-nav a {
    display: flex;
    gap: 15px;
    justify-content: space-between;
    align-items: center;
    font-size: 11px;
  }
  .research-nav a:hover {
    color: var(--blue-ink);
  }
  .research-nav span {
    font-size: 10px;
    color: oklch(43% 0.014 275);
  }
  .research-group {
    margin-bottom: 54px;
    scroll-margin-top: 110px;
  }
  .research-group h2 {
    font-size: 24px;
    letter-spacing: -0.04em;
    margin: 0 0 22px;
  }
  .research-entry {
    border-top: 1px solid var(--line-light);
    scroll-margin-top: 115px;
  }
  .research-entry:last-child {
    border-bottom: 1px solid var(--line-light);
  }
  .research-entry summary {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto 14px;
    align-items: center;
    gap: 18px;
    padding: 21px 0;
    cursor: pointer;
    list-style: none;
  }
  .research-entry summary::-webkit-details-marker {
    display: none;
  }
  .research-entry summary strong {
    display: block;
    font-size: 16px;
    font-weight: 600;
    line-height: 1.5;
  }
  .research-entry small {
    display: block;
    color: oklch(43% 0.014 275);
    font-size: 10px;
    line-height: 1.7;
    margin-top: 6px;
  }
  .research-assessment {
    font-size: 10px;
    color: var(--blue-ink);
  }
  .research-expand {
    font-size: 22px;
    line-height: 1;
    color: var(--blue-ink);
    font-weight: 400;
  }
  .research-entry[open] .research-expand {
    transform: rotate(45deg);
  }
  .research-entry[open] {
    background: var(--mist);
    padding-inline: 22px;
    margin-inline: -22px;
  }
  .research-detail {
    padding: 0 0 26px;
  }
  .research-detail dl {
    margin: 0;
  }
  .research-detail dl > div {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr);
    gap: 20px;
    margin: 0 0 18px;
    font-size: 12px;
  }
  .research-detail dt {
    font-weight: 650;
  }
  .research-detail dd {
    margin: 0;
    max-width: 68ch;
    color: oklch(37% 0.016 275);
  }
  .research-sources {
    display: flex;
    gap: 8px 17px;
    flex-wrap: wrap;
    align-items: center;
    font-size: 10px;
  }
  .research-sources > span {
    font-weight: 650;
  }
  .research-sources a {
    display: inline-flex;
    gap: 5px;
    align-items: center;
    color: var(--blue-ink);
    overflow-wrap: anywhere;
  }
  .research-reuse {
    border-top: 1px solid var(--line-light);
    padding-top: 35px;
  }
  .research-reuse > h2 {
    font-size: clamp(28px, 3vw, 40px);
    letter-spacing: -0.045em;
    margin: 20px 0;
  }
  .research-reuse p,
  .research-questions p,
  .research-questions li {
    font-size: 13px;
    color: oklch(40% 0.016 275);
  }
  .research-reuse article {
    margin: 35px 0;
    padding-bottom: 30px;
    border-bottom: 1px solid var(--line-light);
  }
  .research-reuse h3 {
    font-size: 20px;
    letter-spacing: -0.03em;
  }
  .research-reuse .research-recommendation {
    font-weight: 650;
    color: var(--ink);
  }
  .research-questions h2 {
    font-size: 24px;
    letter-spacing: -0.03em;
  }
  .research-questions ul {
    padding-left: 20px;
  }
  .research-questions li {
    margin-bottom: 14px;
  }
  .research-questions a {
    color: var(--blue-ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .research-empty {
    padding: 25px;
    background: var(--mist);
    font-size: 14px;
  }
  @media (max-width: 900px) {
    .research-layout {
      grid-template-columns: 1fr;
    }
    .research-nav {
      position: static;
      grid-template-columns: 1fr 1fr;
      gap: 14px 30px;
    }
    .research-controls {
      grid-template-columns: 1fr 1fr;
    }
    .research-controls button {
      justify-self: start;
    }
  }
  @media (max-width: 560px) {
    .research-context {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .research-controls {
      grid-template-columns: 1fr;
      gap: 12px;
    }
    .research-entry summary {
      grid-template-columns: minmax(0, 1fr) 14px;
      gap: 9px 15px;
    }
    .research-assessment {
      grid-row: 2;
    }
    .research-expand {
      grid-column: 2;
      grid-row: 1 / 3;
    }
    .research-detail dl > div {
      grid-template-columns: 1fr;
      gap: 5px;
    }
    .research-entry[open] {
      padding-inline: 14px;
      margin-inline: -14px;
    }
  }
</style>
