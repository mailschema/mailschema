---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import { typeRecords, typeStatusLabel, specification, type TypeRecord } from '../../data/types';
import '../../styles/catalog.css';
import '../../styles/prose.css';
import '../../styles/registry.css';
export function getStaticPaths() {
  return typeRecords.map((record) => ({ params: { type: record.slug }, props: { record } }));
}
interface Props {
  record: TypeRecord;
}
const { record } = Astro.props;
---

<Base title={`${record.name} · Registry`} description={record.summary} theme="light">
  <main id="main" class="container">
    <header class="page-hero">
      <div class="breadcrumb">
        <a href="/registry">Registry</a>
        <Icon name="chevron" size={12} />
        <span>{record.name}</span>
      </div>
      <span class="eyebrow eyebrow-line">{record.category}</span>
      <h1>{record.name}</h1>
      <p class="lead">{record.summary}</p>
    </header>
    <div class="longform">
      <aside class="longform-aside">
        <span class="pill soft" data-type-status>
          {typeStatusLabel(record)}
        </span>
        <dl class="detail-facts">
          <div>
            <dt>Specification</dt>
            <dd>
              <a href="/specification/core">MAP {specification.version}</a>
            </dd>
          </div>
          <div>
            <dt>Maintained by</dt>
            <dd>
              {record.maintainers.map((party) => (
                <a href={party.href}>{party.name}</a>
              ))}
            </dd>
          </div>
          <div>
            <dt>Contract version</dt>
            <dd>{record.version}</dd>
          </div>
        </dl>
        <nav class="type-contents" aria-label="Type record sections">
          <a href="#operations">Operations</a>
          <a href="#requirements">Requirements</a>
          <a href="#details">Details schema</a>
          <a href="#example">Example</a>
          <a href="#identity">Contract identity</a>
          <a href="#implementations">Implementations</a>
        </nav>
        <div class="type-downloads">
          <a class="type-record-download" href={record.contractHref} download>
            Download contract <Icon size={14} />
          </a>
          <a class="type-record-download" href={record.exampleHref} download>
            Download example <Icon size={14} />
          </a>
        </div>
      </aside>
      <article class="prose">
        <h2 id="operations">Operations</h2>
        <p>
          The contract defines what each operation means. A trusted connector maps it to the
          service’s existing operations; the email supplies no credential destination or execution
          endpoint.
        </p>
        {record.operations.map((operation) => (
          <section>
            <h3 id={`operation-${operation.id}`}>{operation.name}</h3>
            <p>{operation.semantics}</p>
            <dl class="implementation-facts">
              <div>
                <dt>Operation ID</dt>
                <dd>
                  <code>{operation.id}</code>
                </dd>
              </div>
              <div>
                <dt>Bindings</dt>
                <dd>
                  {operation.bindings
                    .map((binding) =>
                      binding === 'credential'
                        ? 'Connected service operation'
                        : 'Experimental capability',
                    )
                    .join(' · ')}
                </dd>
              </div>
              <div>
                <dt>Effects</dt>
                <dd>
                  {operation.effects.map((effect, index) => (
                    <Fragment>
                      {index > 0 && ' · '}
                      {effect.startsWith('https://mailschema.org/effects/') ? (
                        <a href={effect}>{effect.split('/').pop()}</a>
                      ) : (
                        effect.split('/').pop()
                      )}
                    </Fragment>
                  ))}
                </dd>
              </div>
              <div>
                <dt>Exact terms</dt>
                <dd>{operation.exactTerms ? 'Required' : 'Not required'}</dd>
              </div>
            </dl>
            {operation.capability && (
              <p>
                Capability scope: <code>{operation.capability.kind}</code>. Maximum lifetime:{' '}
                {operation.capability.maxLifetimeSeconds / 3600} hours, bounded by the message’s
                expiry.
              </p>
            )}
            {operation.inputSchema ? (
              <CodeBlock
                lang="json"
                label="Operation input schema"
                code={JSON.stringify(operation.inputSchema, null, 2)}
              />
            ) : (
              <p>This operation takes no additional input.</p>
            )}
            <dl class="type-operations">
              {Object.entries(operation.outcomes).map(([outcome, meaning]) => (
                <div>
                  <dt>{outcome}</dt>
                  <dd>{meaning}</dd>
                </div>
              ))}
            </dl>
          </section>
        ))}
        <h2 id="requirements">Requirements</h2>
        <ol>
          {record.requirements.map((requirement) => (
            <li>{requirement}</li>
          ))}
        </ol>
        <h2 id="details">Details schema</h2>
        <p>
          This schema constrains the description’s <code>details</code>. The{' '}
          <a href="/specification/core">Core</a> supplies the common fields and processing
          requirements.
        </p>
        <details class="type-code-disclosure">
          <summary>
            View complete JSON Schema <Icon name="chevron" size={14} />
          </summary>
          <CodeBlock
            lang="json"
            label="JSON Schema 2020-12"
            code={JSON.stringify(record.detailsSchema, null, 2)}
          />
        </details>
        <h2 id="example">{record.example.subject.title}</h2>
        <p>
          An illustrative description using this exact contract. Example service addresses and
          digests do not identify a live integration.
        </p>
        <details class="type-code-disclosure">
          <summary>
            View complete MAP description <Icon name="chevron" size={14} />
          </summary>
          <CodeBlock
            lang="json"
            label="MAP description"
            code={JSON.stringify(record.example, null, 2)}
          />
        </details>
        <h2 id="identity">Contract identity</h2>
        <p>
          <code>{record.id}</code> · version <code>{record.version}</code>
        </p>
        <p>
          The canonical digest binds the whole contract, including its requirements and operation
          semantics. Registry listing grants no authority to perform an operation.
        </p>
        <pre><code>{record.digest}</code></pre>
        <p>
          <a href={specification.catalog}>Machine-readable catalogue →</a>
        </p>
        {record.history.length > 0 && (
          <section>
            <h3>Earlier versions</h3>
            <ul>
              {record.history.map((version) => (
                <li>
                  <a href={version.contractHref}>Version {version.version}</a> · {version.status}
                  {version.successor && <> · successor: {version.successor}</>}
                </li>
              ))}
            </ul>
          </section>
        )}
        <h2 id="implementations">Implementations</h2>
        {record.implementations.length === 0 ? (
          <p>No service support is listed for this contract version yet.</p>
        ) : (
          record.implementations.map((implementation) => (
            <section class="type-implementation">
              <span class="pill soft">
                {implementation.evidence.some((item) => item.kind === 'test-report')
                  ? 'Implementation report'
                  : 'Support declaration'}
              </span>
              <h3>
                <a href={implementation.documentation}>{implementation.maintainer.name}</a>
              </h3>
              <p>
                Service: <a href={implementation.service}>{implementation.service}</a>
              </p>
              <p>
                Operations: {implementation.operations.join(', ')} · {implementation.status}
              </p>
              {implementation.evidence.map((item) => (
                <p>
                  <a href={item.url}>{item.kind === 'test-report' ? 'Report' : 'Declaration'}</a>:{' '}
                  {item.summary}
                </p>
              ))}
              <p>
                This listing describes the stated support; it does not connect an account or certify
                the service.
              </p>
            </section>
          ))
        )}
        <p>
          <a href="/contribute#service-bindings">List service support →</a>
        </p>
      </article>
    </div>
  </main>
</Base>
