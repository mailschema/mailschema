---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import CodeBlock from '../components/CodeBlock.astro';
import { typeRecords, specification } from '../data/types';
import { packages } from '../data/packages';
import { digest } from '../map/core';
import shapeVectors from '../../conformance/map-0.3/shape-vectors.json';
import jsonVectors from '../../conformance/map-0.3/json-vectors.json';
import jcsVectors from '../../conformance/map-0.3/jcs-vectors.json';
import scenarios from '../../conformance/map-0.3/scenarios.json';
import '../styles/catalog.css';
import '../styles/tools.css';
const artifacts = [
  [
    'Publication email',
    'examples/publication.eml',
    'The complete unsigned MIME illustration, with the generated MAP description.',
  ],
  [
    'Native OpenAPI example',
    'bindings/publication.openapi.json',
    'The illustrative publishing service’s native read and decision operations.',
  ],
  [
    'MCP exchange',
    'bindings/publication.mcp.json',
    'Illustrative tool schemas, reads, decisions and results for the same proposal.',
  ],
  [
    'Implementation record schema',
    'schemas/implementation.schema.json',
    'Service identity, exact type, binding and support evidence; artifact fields for distributed integrations.',
  ],
  [
    'Core schema',
    'schemas/core.schema.json',
    'Common description fields, types and structural constraints.',
  ],
  [
    'Contract schema',
    'schemas/contract.schema.json',
    'Type identity, requirements, operation semantics, effects and bindings.',
  ],
  [
    'JSON-LD context',
    'context.jsonld',
    'The fixed context for offline processing of MAP descriptions.',
  ],
  [
    'Shape vectors',
    'conformance/shape-vectors.json',
    `${shapeVectors.length} executable valid and invalid cases against the Core and details schemas.`,
  ],
  [
    'JSON vectors',
    'conformance/json-vectors.json',
    `${jsonVectors.length} MAP JSON texts parsed within the 64 KiB description limit: each is refused, or accepted with its RFC 8785 canonical form.`,
  ],
  [
    'RFC 8785 vectors',
    'conformance/jcs-vectors.json',
    `${jcsVectors.length} JSON values with their canonical form and digest, including the Publication Approval example description.`,
  ],
  [
    'Runtime scenarios',
    'conformance/scenarios.json',
    `${scenarios.length} scenario skeletons for service and consumer adapters. These are not executable runtime tests.`,
  ],
  [
    'Internet-Draft source',
    'draft-mailschema-mail-action-protocol-00.xml',
    'The generated individual -00 candidate in RFCXML. No IETF submission or adoption is claimed.',
  ],
];
// The command-line example checks a published contract and its example, so the output shown is
// exactly what the selected npm release prints for them.
const npm = packages.find((item) => item.registry === 'npm');
const cli = typeRecords.find((type) => type.slug === 'campaign-send-approval');
if (!cli) throw new Error('The command-line example needs the Campaign Send Approval type.');
const [contractFile, descriptionFile] = [cli.contractHref, cli.exampleHref].map((href) =>
  href.split('/').pop(),
);
const cliCommands =
  npm &&
  [
    `npm install mailschema@${npm.version}`,
    `curl -O ${new URL(cli.contractHref, Astro.site)}`,
    `curl -O ${new URL(cli.exampleHref, Astro.site)}`,
    `npx mailschema contract ${contractFile}`,
    `npx mailschema description ${descriptionFile} --contract ${contractFile}`,
  ].join('\n');
const cliOutput = [
  `Valid type contract ${cli.id} ${cli.version}`,
  cli.digest,
  `Valid MAP 0.3 description ${cli.example['@id']}`,
  digest(cli.example),
].join('\n');
---

<Base
  title="Schemas and tools"
  theme="light"
  description="MAP schemas, type contracts, examples and conformance material, from the same sources as the current specification."
>
  <main id="main" class="container">
    <header class="page-hero">
      <span class="eyebrow eyebrow-line">Build with MAP</span>
      <h1>Schemas and tools</h1>
      <p class="lead">
        Start with a complete email example and its contract. The schemas and checks are here when
        you're ready to connect your service.
      </p>
    </header>
    <section class="catalog-note catalog-rule">
      <h2>Draft artifacts</h2>
      <div>
        <p>
          These downloads come from the same sources as the reader and Registry. They are working
          drafts; a shape check does not establish message authenticity, permission or safe
          execution.
        </p>
        <ul class="artifact-list">
          {artifacts.map(([label, path, description]) => (
            <li>
              <a href={`${specification.artifacts}/${path}`} download>
                {label}
                <Icon size={15} />
              </a>
              <p>{description}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>
    <section class="catalog-note">
      <h2>Contracts and examples</h2>
      <div>
        <p>
          Each type has its own contract version and canonical digest. The Registry publishes types
          independently of packages.
        </p>
        <ul class="artifact-list">
          {typeRecords.map((type) => (
            <li>
              <a href={`/registry/${type.slug}`}>
                {type.name}
                <Icon size={15} />
              </a>
              <p>
                <a href={type.contractHref} download>
                  JSON contract
                </a>
                {' · '}
                <a href={type.exampleHref} download>
                  Complete description
                </a>
              </p>
            </li>
          ))}
        </ul>
        <a class="text-link" href={specification.catalog}>
          Machine-readable catalogue <Icon size={15} />
        </a>
      </div>
    </section>
    {cliCommands && (
      <section class="catalog-note" id="command-line">
        <h2>Check files from the command line</h2>
        <div>
          <p>
            The npm package includes a <code>mailschema</code> command for local files. This example
            downloads the {cli.name} contract and its complete description, then checks each.
            Nothing is uploaded or changed.
          </p>
          <CodeBlock label="Node.js 22 or later" code={cliCommands} />
          <p>
            <code>contract</code> prints the contract’s identifier and version, then its digest. A
            description names that digest in <code>type.contractDigest</code>, and implementations
            pin contracts by it. <code>description</code> prints the description’s <code>@id</code>,
            then the digest of the description itself; with <code>--contract</code>, it first checks
            that the description uses that contract as it allows. Each digest is the SHA-256 of the
            document’s RFC 8785 canonical JSON.
          </p>
          <CodeBlock label="Output" lang="text" code={cliOutput} />
          <p>
            An invalid file prints every reason on standard error and exits with status 1.{' '}
            <code>mailschema implementation</code> checks a Registry implementation record, and{' '}
            <code>mailschema --help</code> lists the commands. Checking does not authenticate a
            message, establish a service’s authority or perform an action.
          </p>
        </div>
      </section>
    )}
    <section class="catalog-note" id="validation">
      <h2>Validate the sources</h2>
      <div>
        <p>
          In a checkout of the repository, the specification check validates contracts, checks
          example digests, expands JSON-LD offline and runs the shape vectors. It also checks that
          runtime scenario references point to real requirements.
        </p>
        <CodeBlock
          label="Node.js 24 or later"
          code={'npm ci\nnpm run spec:check\nnpm run draft:check'}
        />
        <p>
          After editing a contract or source example, run <code>npm run spec:generate</code> to
          update its projections. <a href="/specification/conformance">Runtime conformance</a>{' '}
          requires service and consumer adapters with observable evidence.
        </p>
      </div>
    </section>
    {packages.length > 0 && (
      <section class="catalog-note" id="packages">
        <h2>Language packages</h2>
        <div>
          <p>
            Each release carries the profile record, context and schemas byte for byte, verified by
            public registry readback.
          </p>
          <ul class="artifact-list">
            {packages.map((item) => (
              <li>
                <a href={item.url}>
                  {item.language} · {item.source} {item.version}
                  <Icon size={15} />
                </a>
                <p>{item.summary}</p>
                <CodeBlock label={item.language} code={item.install} />
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}
  </main>
</Base>
<style>
  .artifact-list {
    list-style: none;
    padding: 0;
    margin: 25px 0;
  }
  .artifact-list li {
    padding: 18px 0;
    border-bottom: 1px solid var(--line-light);
  }
  .artifact-list li > a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    font-weight: 600;
  }
  .artifact-list p {
    margin: 8px 0 0;
  }
  /* Command output keeps its lines and scrolls inside its block instead of widening the page. */
  .catalog-note > div {
    min-width: 0;
  }
  /* Keep command names and flags such as --contract whole. */
  #command-line p code {
    white-space: nowrap;
  }
</style>
