---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import '../styles/catalog.css';
---

<Base title="Page not found">
  <main id="main" class="container error-page">
    <span class="eyebrow eyebrow-line">Page not found</span>
    <div class="error-number">404</div>
    <h1>That page isn’t here.</h1>
    <p>Try the current specification or search the site.</p>
    <a href="/specification" class="button primary">
      Read Mail Action Protocol <Icon size={17} />
    </a>
  </main>
</Base>
