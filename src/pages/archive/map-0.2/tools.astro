---
import Base from '../../../layouts/Base.astro';
import Icon from '../../../components/Icon.astro';
import CodeBlock from '../../../components/CodeBlock.astro';
import { tooling, packageSetLabel, recordCheckCommands } from '../../../data/tooling';
import '../../../styles/tools.css';

const names = (list: { name: string }[]) =>
  list.length > 1
    ? `${list
        .slice(0, -1)
        .map((tool) => tool.name)
        .join(', ')} and ${list.at(-1)!.name}`
    : (list[0]?.name ?? '');
const python = tooling.find((tool) => tool.registry === 'PyPI');
const historicalProfile =
  'https://github.com/mailschema/mailschema/blob/c1b64de71b5d3caf56bcbd4cc6f95d00f7e87efc/docs/specification/profile.md';
---

<Base
  title="MAP 0.2 packages · Archive"
  theme="light"
  description={`Install MailSchema for ${names(tooling).replace(/ and ([^,]+)$/, ' or $1')}. Validate MAP documents, bundle the exact schemas and prepare Registry contributions.`}
>
  <main id="main" class="container tools-page">
    <header class="page-hero tools-hero">
      <div>
        <span class="eyebrow eyebrow-line">Historical packages</span>
        <h1>MAP 0.2 packages</h1>
        <p class="lead">
          These verified releases target MAP 0.2. They do not implement the current draft. For MAP
          0.3, start with the <a href="/tools">current schemas and tools</a>.
        </p>
      </div>
      <div class="tools-hero-aside">
        <span class="pill soft">{packageSetLabel}</span>
        <p>
          The complete contract bytes,
          <br />
          verified in every selected release.
        </p>
        <a href={historicalProfile} class="text-link">
          Read the MAP 0.2 profile <Icon size={16} />
        </a>
      </div>
    </header>

    <div class="tool-selector">
      <nav class="tool-tabs" data-tool-tabs aria-label="Package language">
        {tooling.map((tool) => (
          <a id={`tab-${tool.id}`} href={`#${tool.id}`}>
            <span>{tool.name}</span>
            <small>{tool.registry}</small>
          </a>
        ))}
      </nav>
      <a class="tool-schema-link" href="/schemas/contribution.schema.json" download>
        JSON Schema <Icon name="file" size={15} />
      </a>
    </div>

    {tooling.map((tool) => (
      <section id={tool.id} class="tool-panel" aria-label={tool.name}>
        <div class="tool-start">
          <div class="tool-setup">
            <div class="tool-runtime">
              <span>
                {tool.runtime} · MAP {tool.map}
              </span>
              <a href={tool.release.url}>
                {tool.registry} · {tool.release.version}
                <Icon name="northeast" size={13} />
              </a>
            </div>
            <h2>{tool.title}</h2>
            <p>{tool.description}</p>
            <CodeBlock
              label={tool.id === 'rust' ? 'Cargo.toml' : 'Install'}
              code={tool.install}
              lang={tool.installLanguage}
            />
            {tool.command && <CodeBlock label="Check a contribution" code={tool.command} />}
            {tool.command ? (
              <a
                class="text-link"
                href="/contribution-examples/new-type.json"
                download="contribution.json"
              >
                Download an example <Icon name="file" size={15} />
              </a>
            ) : (
              tool.note && <p class="tool-small">{tool.note}</p>
            )}
          </div>
          <div class="tool-example">
            <CodeBlock label={tool.filename} code={tool.example} lang={tool.language} />
            <p>{tool.exampleNote}</p>
          </div>
        </div>
        <div class="tool-api">
          <div>
            <span class="eyebrow">API reference</span>
            <p>{tool.exports}</p>
          </div>
          <dl>
            {tool.api.map((entry) => (
              <div>
                <dt>
                  <code>{entry.name}</code>
                </dt>
                <dd>{entry.description}</dd>
              </div>
            ))}
          </dl>
        </div>
      </section>
    ))}

    <section class="tools-section" id="records" aria-labelledby="records-title">
      <div class="tools-section-copy">
        <span class="eyebrow eyebrow-line">Registry records</span>
        <h2 id="records-title">Check the record, too.</h2>
        <p>
          A contribution proposes a change. A record is the resulting definition, with its
          contributors, maintainers and history.
        </p>
        <p>
          Choose <strong>Download record</strong> on any type page, then check it with{' '}
          <code>--record</code>. Start with Content Review:
        </p>
        <a
          href="/registry/records/content-review.record.json"
          download="content-review.json"
          class="text-link"
        >
          Download Content Review <Icon name="file" size={15} />
        </a>
      </div>
      <div class="tools-section-code">
        <CodeBlock label="JavaScript" code={recordCheckCommands.javascript} />
        <CodeBlock
          label={`Python · after ${python?.install ?? 'installation'}`}
          code={recordCheckCommands.python}
        />
        <p>
          In Rust or Go, load the bundled Registry schema into your validator. For amendments and
          implementation declarations, the <a href="/registry/catalog.json">Registry catalogue</a>{' '}
          also provides exact record digests.
        </p>
      </div>
    </section>

    <section class="tools-section tools-checks" aria-labelledby="checks-title">
      <div class="tools-section-copy">
        <span class="eyebrow eyebrow-line">From a file to a contribution</span>
        <h2 id="checks-title">What passing means.</h2>
        <p>Each check answers a different question. A valid file is ready for the next step.</p>
      </div>
      <ol class="tool-check-list">
        <li>
          <span>01</span>
          <div>
            <h3>Structure</h3>
            <p>
              Required fields, exact identifiers, allowed values and URI formats. The JavaScript and
              Python validators check these locally against the shared schemas.
            </p>
          </div>
        </li>
        <li>
          <span>02</span>
          <div>
            <h3>Registry references</h3>
            <p>
              Does the target exist? Is the amendment current? Are the operations supported? Use the
              browser checker, or JavaScript’s <code>referenceErrors</code> with a supplied
              catalogue.
            </p>
          </div>
        </li>
        <li>
          <span>03</span>
          <div>
            <h3>Review</h3>
            <p>
              The repository checks conflicting changes. Review considers the definition,
              attribution and evidence. Passing validation does not establish acceptance or product
              compatibility.
            </p>
          </div>
        </li>
      </ol>
    </section>

    <p class="tools-scope">
      {`The ${names(tooling)} packages carry the MAP 0.2 core artifacts exactly as published, and the JavaScript and Ruby packages also process MAP documents. `}
      Public artifact readback verifies every contract bundled in the selected releases. Registry
      types are published independently; adding a type does not require releases in every language.
      Clients obtain the exact type versions they act on from the Registry catalogue by digest, or
      vendor them. The packages validate documents; they do not establish endpoint trust, grant
      authorization or send email. Read the <a href={historicalProfile}>MAP 0.2 profile</a> before
      acting on a message. Package and specification versions are independent.
    </p>
  </main>
</Base>
<script>
  import '../../../scripts/tool-tabs';
</script>
