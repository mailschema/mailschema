---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { typeRecords, typeHref, typeStatusLabel, typeCollectionSummary } from '../../data/types';
import '../../styles/catalog.css';
---

<Base
  title="Interaction types"
  theme="light"
  description="How MailSchema interaction types define shared actions, inputs and results for agents and services."
>
  <main id="main" class="container">
    <header class="page-hero catalog-hero">
      <div>
        <span class="eyebrow eyebrow-line">MailSchema Types</span>
        <h1>Interaction types</h1>
        <p class="lead">
          A type describes a kind of work an agent can handle through email. It defines the actions
          available, the information they need and what each result means.
        </p>
      </div>
      <div class="catalog-art types-art" aria-hidden="true">
        <Icon name="layers" size={130} />
      </div>
    </header>
    <section class="catalog-rule" aria-label="Interaction type collection">
      <div class="types-intro">
        <p>
          Start with the work your service asks someone to do. Each entry links to its definition,
          examples and review history in the Registry.
        </p>
        <span class="types-count">{typeCollectionSummary}</span>
      </div>
      <ol class="type-collection">
        {typeRecords.map((type, index) => (
          <li>
            <a class="type-entry" href={typeHref(type.slug)} data-type-summary={type.slug}>
              <span class="type-number" aria-hidden="true">
                {String(index + 1).padStart(2, '0')}
              </span>
              <div class="type-copy">
                <div class="type-meta">
                  <span class="eyebrow">{type.category}</span>
                  <span class="pill soft" data-type-status>
                    {typeStatusLabel(type)}
                  </span>
                </div>
                <h2>{type.name}</h2>
                <p data-type-description>{type.summary}</p>
                <p class="type-example">
                  <span>Example</span>
                  {type.example.title}
                </p>
              </div>
              <div class="type-operation-summary">
                <span class="eyebrow">
                  {type.status === 'Draft' ? 'Operations in the draft' : 'Proposed operations'}
                </span>
                <ul data-type-operations>
                  {type.operations.map((operation) => (
                    <li>{operation.name}</li>
                  ))}
                </ul>
              </div>
              <Icon name="northeast" size={22} />
            </a>
          </li>
        ))}
      </ol>
      <p class="types-stage-note">
        Drafts are open for review. Proposals describe work still being scoped. Reuse assessments
        start with existing standards and ask whether a MAP binding is needed.
      </p>
    </section>
    <section class="catalog-note">
      <h2>Using a type</h2>
      <div>
        <p>
          Start with the Registry. Read the definition and examples, check the version, and identify
          which operations your service or client will support. The execution profile supplies the
          rules for exchanging requests and results.
        </p>
        <a class="text-link" href="/registry/">
          Browse the Registry <Icon size={16} />
        </a>
      </div>
    </section>
    <section class="catalog-note catalog-rule">
      <h2>Proposing a type</h2>
      <div>
        <p>
          A new type should describe an interaction that more than one service could use. Check
          whether an existing type or standard covers the work, then document any additional
          behaviour your proposal needs.
        </p>
        <a class="text-link" href="/contribute/#propose-a-type">
          Prepare a type proposal <Icon size={16} />
        </a>
      </div>
    </section>
  </main>
</Base>
