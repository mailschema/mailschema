---
import Icon from './Icon.astro';
import { typeRecords, typeVersions } from '../data/types';
import '../styles/contribution.css';
---

<section class="contribution-checker" aria-labelledby="check-a-contribution">
  <div class="contribution-intro">
    <div>
      <span class="eyebrow eyebrow-line">Prepare a contribution</span>
      <h2 id="check-a-contribution">Check a contribution.</h2>
    </div>
    <p>
      Start from a contract or a service record, then check the JSON and preview what you are
      proposing. The file stays in your browser until you choose to continue in GitHub.
      <a href="#local-validation" class="contribution-local-link">
        Prefer to validate locally? <Icon size={14} />
      </a>
    </p>
  </div>
  <div class="contribution-examples">
    <span>Start from a contract</span>
    {typeRecords.map((type) => (
      <a href={type.contractHref} data-example={type.slug}>
        {type.name}
        <Icon size={13} />
      </a>
    ))}
  </div>
  <form id="contribution-form" hidden>
    <div class="contribution-editor-heading">
      <label for="contribution-kind">Contribution</label>
      <select id="contribution-kind">
        <option value="contract">Type contract</option>
        <option value="implementation">Service support</option>
      </select>
    </div>
    <div class="contribution-editor-heading" data-service-target hidden>
      <label for="contribution-target">Contract supported</label>
      <select id="contribution-target">
        {typeVersions.map((type) => (
          <option
            value={type.slug}
            data-id={type.id}
            data-version={type.version}
            data-digest={type.digest}
            data-operations={type.operations.map((op) => op.id).join(',')}
          >
            {type.name} · {type.version}
          </option>
        ))}
      </select>
      <button type="button" data-service-starter>
        Start a service record
      </button>
    </div>
    <div class="contribution-editor-heading">
      <label for="contribution-json" data-editor-label>
        Contract JSON
      </label>
      <label class="contribution-file">
        Load a file <input id="contribution-file" type="file" accept=".json,application/json" />
      </label>
    </div>
    <textarea
      id="contribution-json"
      rows="12"
      spellcheck="false"
      autocomplete="off"
      placeholder="Paste a contract, or choose one above."
      required
    ></textarea>
    <div class="contribution-actions">
      <button class="button dark-button" type="submit">
        Check and preview <Icon size={16} />
      </button>
      <span role="status" data-check-status></span>
    </div>
    <div class="contribution-errors" role="alert" hidden>
      <h3>Check these fields</h3>
      <ul></ul>
    </div>
  </form>
  <noscript>
    <p>Download an example and run the command below to validate it locally.</p>
  </noscript>
  <div class="contribution-preview" data-preview hidden>
    <span class="eyebrow">Contract preview</span>
    <h3 data-preview-title></h3>
    <p data-preview-summary></p>
    <dl data-preview-facts></dl>
    <p class="contribution-preview-note">
      Structural checks passed. Meaning, ownership and any support claims still need review. Add the
      companion files described below when opening the pull request.
    </p>
    <div class="contribution-submit">
      <div>
        <span class="eyebrow">Ready for review</span>
        <h4>Propose this contribution.</h4>
        <p>
          GitHub handles your identity, branch and pull request. MailSchema publishes accepted
          contributions after repository review and merge.
        </p>
        <p class="contribution-submit-note" data-submit-note>
          The checked JSON will be prefilled in GitHub.
        </p>
      </div>
      <div class="contribution-submit-actions">
        <a
          class="button primary"
          data-submit
          target="_blank"
          rel="noreferrer"
          aria-disabled="true"
          tabindex="-1"
        >
          <span data-submit-label>Continue in GitHub</span> <Icon name="northeast" size={16} />
        </a>
        <button class="contribution-download" type="button" data-download disabled>
          Download checked JSON <Icon name="file" size={14} />
        </button>
      </div>
    </div>
  </div>
</section>
<script>
  import '../scripts/contribution-checker';
</script>
